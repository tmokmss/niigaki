---
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html, body { margin: 0; min-height: 100%; background: #0d0f14; color: #d8dbe2; font-family: "Hiragino Mincho ProN", serif; }
  a { color: inherit; }
</style>
