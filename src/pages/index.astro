---
import Base from "../layouts/Base.astro";
import { pieces } from "../pieces";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="niigaki">
  <main>
    <h1>niigaki</h1>
    <ul>
      {pieces.map((p) => {
        const hue = "hues" in p ? p.hues?.[0] : undefined;
        return (
          <li style={hue === undefined ? "--c: #8a8f9c" : `--c: hsl(${hue} 85% 65%)`}>
            <a href={`${base}/${p.slug}/`}>
              <span class="title">{p.title}</span>
              <span class="meta">{p.description}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</Base>

<style>
  main { max-width: 36rem; margin: 0 auto; padding: 4.5rem 1.25rem 4rem; font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif; }
  h1 { font-weight: 700; font-size: 2rem; letter-spacing: -.01em; margin: 0 0 2.5rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .4rem; }
  a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .2rem 1rem; padding: .85rem 1rem; border-left: 3px solid var(--c); background: #161922; text-decoration: none; transition: background .15s; }
  a:hover { background: color-mix(in srgb, var(--c) 14%, #161922); }
  .title { font-size: 1.05rem; font-weight: 600; }
  .meta { color: var(--c); font-size: .78rem; letter-spacing: .02em; opacity: .85; }
  @media (max-width: 30rem) { a { flex-direction: column; } }
</style>
